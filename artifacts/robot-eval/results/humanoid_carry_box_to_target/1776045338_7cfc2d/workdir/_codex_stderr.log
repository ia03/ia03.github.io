def stable(sim: Sim) -> bool:
    return (
        sim.pelvis_position()[2] >= MIN_PELVIS_Z
        and sim.torso_up() >= MIN_TORSO_UP
        and sim.box_position()[2] >= MIN_BOX_Z
        and sim.box_distance_to_pelvis() <= MAX_BOX_TO_PELVIS
    )


def evaluate_ctrl_trace(ctrl_trace: np.ndarray):
    sim = Sim()
    for ctrl in ctrl_trace:
        sim.data.ctrl[:] = ctrl
        sim.step()
    replay_steps = len(ctrl_trace)
    stable_count = 0
    pelvis_x_max = -1e9
    box_x_max = -1e9
    for item in sim._trace:
        pelvis_x_max = max(pelvis_x_max, float(item["pelvis_pos"][0]))
        box_x_max = max(box_x_max, float(item["box_pos"][0]))
        ok = (
            item["pelvis_pos"][2] >= MIN_PELVIS_Z
            and item["torso_up"] >= MIN_TORSO_UP
            and item["box_pos"][2] >= MIN_BOX_Z
            and item["box_distance_to_pelvis"] <= MAX_BOX_TO_PELVIS


def run_policy(params, save_path="/work/final_state.npz", save=False):
    sim = Sim()
    home = sim.home_ctrl()
    ctrl = home.copy()

    arm_pose = np.array([
        params["torso"],
        params["lsp"],
        params["lsr"],
        params["lsy"],
        params["lel"],
        params["rsp"],
        params["rsr"],
        params["rsy"],
        params["rel"],
    ])

    ctrl[10:] = arm_pose
    sim.data.ctrl[:] = ctrl
    sim.step(params["settle0"])

    for t in range(params["steps"]):
        phase = 2.0 * math.pi * t / max(1, params["period"])
        s = math.sin(phase)
        c = math.cos(phase)
        ctrl = home.copy()
        ctrl[10:] = arm_pose
        ctrl[2] = params["hip_base"] + params["hip_amp"] * s
        ctrl[3] = params["knee_base"] - params["knee_amp"] * s
        ctrl[4] = params["ankle_base"] + params["ankle_amp"] * s
        ctrl[7] = params["hip_base"] - params["hip_amp"] * s
        ctrl[8] = params["knee_base"] + params["knee_amp"] * s
        ctrl[9] = params["ankle_base"] - params["ankle_amp"] * s
        ctrl[0] = params["yaw_amp"] * c
        ctrl[5] = -params["yaw_amp"] * c
        ctrl[1] = params["roll_bias"] + params["roll_amp"] * c
        ctrl[6] = -params["roll_bias"] - params["roll_amp"] * c
        ctrl[10] = params["torso"] + params["torso_gait"] * s
        sim.data.ctrl[:] = ctrl
        sim.step()

    if save:
        sim.save_final_state(save_path)
    return evaluate_ctrl_trace(np.array(sim._ctrl_trace, dtype=float)), np.array(sim._ctrl_trace, dtype=float)


def main():
    baseline = {
        "settle0": 50,
        "steps": 80,
        "period": 40,
        "torso": 0.2,
        "torso_gait": 0.0,
        "lsp": 0.9,
        "lsr": 0.22,
        "lsy": 0.0,
        "lel": 1.15,
        "rsp": 0.9,
        "rsr": -0.22,
        "rsy": 0.0,
        "rel": 1.15,
        "hip_base": -0.38,
        "hip_amp": 0.12,
        "knee_base": 0.78,
        "knee_amp": 0.20,
        "ankle_base": -0.40,
        "ankle_amp": 0.08,
        "yaw_amp": 0.0,
        "roll_bias": 0.0,
        "roll_amp": 0.04,
    }
    metrics, _ = run_policy(baseline, save=True)
    print(metrics)
