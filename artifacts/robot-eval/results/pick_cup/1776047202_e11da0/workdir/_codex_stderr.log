def run(out_path="/work/final_state.npz", render_debug=False):
    sim = Sim()
    bot = PandaPick(sim)

    # Phase 0: open gripper
    bot.gripper_cmd = 255.0
    bot.settle(200)

    cup0 = bot.cup_pos()

    # Phase 1: pregrasp above cup
    pre = cup0 + np.array([0.0, 0.0, 0.35])
    bot.move_pose(pre, R_des=None, steps=2200, pos_gain=3.0, damping=0.12, max_step=0.02)
    _, R_hold = bot._hand_pose()

    # Phase 2: descend to grasp height
    cup1 = bot.cup_pos()
    grasp = cup1 + np.array([0.0, 0.0, 0.06])
    bot.move_pose(
        grasp,
        R_des=R_hold,
        steps=2800,
        pos_gain=3.0,
        rot_gain=1.5,
        damping=0.12,
        max_step=0.012,
        tol_rot=0.30,
    )

    # Phase 3: close gripper while holding pose (with slight downward bias)
    cup2 = bot.cup_pos()
    grasp2 = cup2 + np.array([0.0, 0.0, 0.065])
    for k in range(550):
        bot._ik_step(grasp2, R_hold, pos_gain=2.5, rot_gain=1.5, damping=0.14, max_step=0.010)
        bot.gripper_cmd = float(max(0.0, 255.0 * (1.0 - (k + 1) / 520.0)))
        bot._step(1)

    # Phase 4: lift
    p_hand, _ = bot._hand_pose()
    lift = p_hand + np.array([0.0, 0.0, 0.40])
    bot.gripper_cmd = 0.0
    bot.move_pose(lift, R_des=R_hold, steps=3200, pos_gain=2.5, rot_gain=1.5, damping=0.14, max_step=0.010, tol_rot=0.35)

    # Phase 5: hold at top
    bot.move_pose(lift, R_des=R_hold, steps=1400, pos_gain=2.0, rot_gain=1.5, damping=0.16, max_step=0.008, tol_rot=0.40)
