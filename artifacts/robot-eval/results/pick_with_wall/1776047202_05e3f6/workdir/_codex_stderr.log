    return q


def run() -> None:
    sim = Sim()
    m = sim.model
    d = sim.data
    R_des = _R_des_y_aligned()

    # Gripper: ctrl[7] in [0,255], where 255=open, 0=closed.
    d.ctrl[7] = 255.0

    # Planning data for kinematic IK (keeps execution sim clean).
    plan_d = mujoco.MjData(m)
    mujoco.mj_resetData(m, plan_d)
    mujoco.mj_forward(m, plan_d)
    plan_ik = PandaIK(m, plan_d, body_name="hand")

    def exec_joint_segment(q_goal: np.ndarray, steps: int, grip: float | None = None) -> None:
        if grip is not None:
            d.ctrl[7] = float(grip)
        q0 = d.ctrl[:7].copy()
        for i in range(steps):
            alpha = (i + 1) / steps
            d.ctrl[:7] = (1 - alpha) * q0 + alpha * q_goal
            sim.step(1)

    cup0 = sim.cup_position().copy()
    pre_above = cup0 + np.array([0.0, 0.0, 0.34])
    pre_above[0] = 0.53
    pre_above[1] = 0.18

    pre_grasp = cup0 + np.array([0.0, 0.0, 0.07])
    pre_grasp[1] = 0.15

    grasp = cup0 + np.array([0.0, 0.0, 0.055])
    grasp[1] = 0.15

    lift = cup0 + np.array([-0.02, 0.0, 0.30])
    lift[1] = 0.15
    lift[2] = max(lift[2], 0.68)

    retract = np.array([0.34, 0.15, 0.70])
    hold = np.array([0.32, 0.15, 0.70])

    # Solve IK for waypoints (starting from current arm qpos).
    q_init = d.qpos[:7].copy()
    q_pre_above = solve_ik_kinematic(m, plan_d, pre_above, R_des, q_init, iters=240)
    q_pre_grasp = solve_ik_kinematic(m, plan_d, pre_grasp, R_des, q_pre_above, iters=220)
    q_grasp = solve_ik_kinematic(m, plan_d, grasp, R_des, q_pre_grasp, iters=220)
    q_lift = solve_ik_kinematic(m, plan_d, lift, R_des, q_grasp, iters=260)
    q_retract = solve_ik_kinematic(m, plan_d, retract, R_des, q_lift, iters=240)
    q_hold = solve_ik_kinematic(m, plan_d, hold, R_des, q_retract, iters=200)

    # Execute: approach above cup (gripper open).
    exec_joint_segment(q_pre_above, steps=600, grip=255)

    # Save an early plausible attempt to ensure the file exists.
    sim.save_final_state("/work/final_state.npz")

    # Descend to pre-grasp and grasp.
    exec_joint_segment(q_pre_grasp, steps=700)
    exec_joint_segment(q_grasp, steps=500)

    # Close gripper while maintaining pose.
    for g in np.linspace(255, 0, 200):
        d.ctrl[7] = float(g)
        d.ctrl[:7] = q_grasp
        sim.step(1)

    # Brief squeeze/hold.
    exec_joint_segment(q_grasp, steps=250, grip=0)

    # Lift.
    exec_joint_segment(q_lift, steps=800)

    # Retract to robot side.
    exec_joint_segment(q_retract, steps=1000)
    exec_joint_segment(q_hold, steps=900)

    # Overwrite with best-so-far.
    sim.save_final_state("/work/final_state.npz")
